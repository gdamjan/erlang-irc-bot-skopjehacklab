%%-*- mode: erlang -*-

{deps, [
    {ircbot, {git, "https://github.com/gdamjan/erlang-irc-bot.git", {branch, "main"}}},
    {hackney, "4.7.2"},
    {couchbeam, "2.0.0"},
    {mochiweb, "3.4.0"},
    {mochiweb_xpath, {git, "https://github.com/retnuh/mochiweb_xpath.git", {branch, "master"}}}
]}.

{relx, [
    {release, {ircbot, "git"},
        %% list of apps to include
        [ircbot, ircbot_skopjehacklab, couchbeam, mochiweb, mochiweb_xpath]},

    {mode, dev},

    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod}
        ]}
    ]},
    {minimal, [
        {relx, [
            {mode, minimal}
        ]}
    ]}
]}.

{shell, [
    {apps, []}
]}.
{minimum_otp_vsn, "27.0"}.
